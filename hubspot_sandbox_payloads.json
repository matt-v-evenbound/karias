   {
    "name": "ed_diversion_tier_calc",
    "label": "ED Diversion Tier Calc",
    "type": "enumeration",
    "fieldType": "calculation_equation",
    "groupName": "contactinformation",
    "description": "Auto-calculated risk tier for the ER Diversion outreach campaign. Self-updates in real time based on ED Indicator, Count for any ED activity within past year, and ED Avoidable Count. \n\nTier 1 = 3+ ED episodes/year with 1+ flagged avoidable. \nTier 2 = exactly 2 ED episodes/year with 1+ flagged avoidable. \nNot Eligible = doesn't meet either threshold.",
    "displayOrder": 0,
    "hasUniqueValue": false,
    "hidden": false,
    "formField": false,
    "calculationFormula": "(if bool(ed_ind) and ed_cnt >= 3 and ed_avoidable_cnt >= 1 then 'Tier 1 - High'\nelse(if bool(ed_ind) and ed_cnt equals 2 and ed_avoidable_cnt >= 1 then 'Tier 2 - Standard' else 'Not Eligible'))",
    "numberDisplayHint": "formatted",
    "showCurrencySymbol": false,
    "externalOptions": false,
    "dataSensitivity": "non_sensitive",
    "options": [
     {
      "label": "Tier 1 - High",
      "value": "Tier 1 - High",
      "displayOrder": 0,
      "hidden": true
     },
     {
      "label": "Tier 2 - Standard",
      "value": "Tier 2 - Standard",
      "displayOrder": 1,
      "hidden": true
     },
     {
      "label": "Not Eligible",
      "value": "Not Eligible",
      "displayOrder": 2,
      "hidden": true
     }
    ]
   },
